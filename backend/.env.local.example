NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Dùng database dev/local riêng để dữ liệu local không nhảy lên website đã deploy.
# Ví dụ PostgreSQL local:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estateai_dev?schema=public

# Cấu hình mail/AI local nếu cần test OTP và tạo nội dung AI.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GEMINI_API_KEY=
